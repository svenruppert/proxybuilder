<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.svenruppert</groupId>
    <artifactId>proxybuilder-parent</artifactId>
    <version>00.11.00-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>proxybuilder</artifactId>

  <name>Sven Ruppert ProxyBuilder</name>
  <description>Runtime proxy builders and annotation processors for generated static proxies.</description>
  <url>http://www.proxybuilder.org</url>

  <dependencies>
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>proxybuilder-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>4.9.8</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.google.testing.compile</groupId>
      <artifactId>compile-testing</artifactId>
      <version>0.21.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgument>-Xlint:all</compilerArgument>
          <compilerArgument>-proc:none</compilerArgument>
          <showWarnings>true</showWarnings>
          <showDeprecation>true</showDeprecation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <targetClasses>
            <param>com.svenruppert.proxybuilder.*</param>
            <param>com.svenruppert.proxybuilder.objectadapter.*</param>
            <param>com.svenruppert.proxybuilder.objectadapter.dynamic.*</param>
            <param>com.svenruppert.proxybuilder.objectadapter.generated.*</param>
            <param>com.svenruppert.proxybuilder.proxy.dymamic.*</param>
            <param>com.svenruppert.proxybuilder.proxy.dymamic.virtual.*</param>
            <param>com.svenruppert.proxybuilder.proxy.dymamic.virtual.factory.*</param>
            <param>com.svenruppert.proxybuilder.proxy.dymamic.virtual.strategy.*</param>
            <param>com.svenruppert.proxybuilder.proxy.generated.*</param>
          </targetClasses>
          <excludedClasses>
            <param>com.svenruppert.proxybuilder.annotations.*</param>
          </excludedClasses>
          <targetTests>
            <param>com.svenruppert.proxybuilder.processor.*</param>
          </targetTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>